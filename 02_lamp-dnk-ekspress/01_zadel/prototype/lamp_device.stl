      vertex 250 0 120
    endloop
  endfacet
  facet normal 0 0 1
    outer loop
      vertex 0 0 120
      vertex 0 200 120
      vertex 250 200 120
    endloop
  endfacet
  facet normal 0 -1 0
    outer loop
      vertex 0 0 0
