solid nir_device
  facet normal 0 0 -1
    outer loop
      vertex 0 0 0
      vertex 180 0 0
      vertex 180 120 0
    endloop
  endfacet
  facet normal 0 0 -1
    outer loop
      vertex 0 0 0
      vertex 180 120 0
      vertex 0 120 0
    endloop
  endfacet
  facet normal 0 0 1
    outer loop
      vertex 0 0 80
      vertex 180 120 80
      vertex 180 0 80
    endloop
  endfacet
  facet normal 0 0 1
    outer loop
      vertex 0 0 80
      vertex 0 120 80
      vertex 180 120 80
    endloop
  endfacet
  facet normal 0 -1 0
    outer loop
      vertex 0 0 0
      vertex 180 0 80
      vertex 180 0 0
    endloop
  endfacet
  facet normal 0 -1 0
    outer loop
      vertex 0 0 0
      vertex 0 0 80
      vertex 180 0 80
    endloop
  endfacet
  facet normal 0 1 0
    outer loop
      vertex 0 120 0
      vertex 180 120 0
      vertex 180 120 80
    endloop
  endfacet
  facet normal 0 1 0
    outer loop
      vertex 0 120 0
      vertex 180 120 80
      vertex 0 120 80
    endloop
  endfacet
  facet normal -1 0 0
    outer loop
      vertex 0 0 0
      vertex 0 120 0
      vertex 0 120 80
    endloop
  endfacet
  facet normal -1 0 0
    outer loop
      vertex 0 0 0
      vertex 0 120 80
      vertex 0 0 80
    endloop
  endfacet
  facet normal 1 0 0
    outer loop
      vertex 180 0 0
